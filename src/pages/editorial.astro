---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Editorial Team | spousalsupportcalc.com';
const description = 'Meet the editorial team behind spousalsupportcalc.com.';
---
<BaseLayout title={title} description={description}>
  <h1>Editorial Team</h1>
  <p>spousalsupportcalc.com is written and reviewed by The Click Lab's editorial team. Every formula is verified against state statutes and family-law treatises.</p>
  <h2>Editorial standards</h2>
  <ul>
    <li>Cite the authority (statute, case, reported guideline)</li>
    <li>No legal advice &mdash; informational only</li>
    <li>No paid placements or recommended-attorney lists</li>
  </ul>
  <h2>Corrections</h2>
  <p>Email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>
</BaseLayout>
