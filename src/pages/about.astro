---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'About spousalsupportcalc.com';
const description = 'About the team behind spousalsupportcalc.com. Free family-law calculators and plain-English guides reviewed by the editorial team at The Click Lab.';
---
<BaseLayout title={title} description={description}>
  <h1>About spousalsupportcalc.com</h1>
  <p>spousalsupportcalc.com is a free family-law resource maintained by The Click Lab. Our calculator and guides help separating spouses understand how spousal support is calculated and what factors affect the outcome.</p>
  <h2>What we do</h2>
  <p>We translate family-law concepts into plain-English calculators and explanations. Every page is reviewed by our <a href="/editorial">editorial team</a> with citations to state statutes and reported case law.</p>
  <h2>What we don't do</h2>
  <p>We don't provide legal advice. Divorce and spousal support disputes depend heavily on jurisdiction, facts, and procedural posture. For your specific situation, consult a family-law attorney.</p>
  <h2>How we make money</h2>
  <p>Display advertising via Google AdSense. We don't sell reader data or accept paid placements. See <a href="/privacy">privacy policy</a>.</p>
  <h2>Contact</h2>
  <p>See our <a href="/contact">contact page</a>.</p>
</BaseLayout>
